# =========================================================================
# Zenith Export AI — environment template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =========================================================================

# --- Django core ---------------------------------------------------------
# REQUIRED, no fallback: the app refuses to boot without it (fail-fast).
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set True only in local development. Production must leave this unset/False.
DJANGO_DEBUG=True

# Comma-separated hosts Django may serve. Never use *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Set True ONLY when the app is always behind a trusted reverse proxy
# (enables SECURE_PROXY_SSL_HEADER). Leave False otherwise.
DJANGO_BEHIND_PROXY=False

# Set True in production behind HTTPS: marks session/CSRF cookies Secure.
DJANGO_COOKIE_SECURE=False

# Relocated admin path (default admin/). Change in production.
DJANGO_ADMIN_URL=admin/

# Where anonymous chat visitors are redirected (the React landing page).
# Dev: the Vite dev server. Production (same-origin): /landing/
LANDING_URL=http://localhost:5173

# Path to the built landing page (zenith-landing/dist). When set, Django
# serves it same-origin at /landing/ — run `npm run build:prod` there first.
# DJANGO_LANDING_DIST=C:/Zenith1/zenith-landing/dist

# --- Database (optional: Postgres in production, SQLite fallback) ----------
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=zenith
# DJANGO_DB_USER=zenith
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- LLM (OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=
# Chat model. Free-tier option: openai/gpt-oss-20b:free
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- NVIDIA (embeddings + OCR) --------------------------------------------
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_LLM_API_KEY=
NVIDIA_OCR_API_KEY=
NVIDIA_API_URL=

# --- Web search providers -------------------------------------------------
TAVILY_API_KEY=
# Optional fallback providers:
JINA_API_KEY=
FIRECRAWL_API_KEY=
